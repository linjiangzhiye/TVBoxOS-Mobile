<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/live_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <xyz.doikki.videoplayer.player.VideoView
        android:id="@+id/mVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 左侧频道抽屉，结构与参考图一致：左分组、右频道。 -->
    <FrameLayout
        android:id="@+id/live_channel_drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/live_channel_drawer_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66000000"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:id="@+id/live_channel_drawer_panel"
            android:layout_width="360dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@color/bg_surface"
            android:elevation="16dp"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="58dp"
            android:paddingEnd="14dp"
            android:paddingBottom="132dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="直播频道"
                android:textColor="@color/text_foreground"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:alpha="0.22"
                android:background="@color/text_hint" />

            <LinearLayout
                android:id="@+id/tvLeftChannnelListLayout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mGroupGridView"
                    android:layout_width="120dp"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:fadeScrollbars="false"
                    android:paddingVertical="8dp"
                    android:scrollbars="none"
                    tools:listitem="@layout/item_live_channel_group_new" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mChannelGridView"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:fadeScrollbars="false"
                    android:focusable="true"
                    android:paddingVertical="8dp"
                    android:scrollbars="none"
                    tools:listitem="@layout/item_live_channel_new" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 底部只保留频道和节目信息，不再承载频道列表。 -->
    <LinearLayout
        android:id="@+id/ll_epg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="10dp"
        android:background="@drawable/bg_large_round_float"
        android:elevation="10dp"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/channelinfo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_channel_logo"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@null"
                    android:scaleType="centerInside"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <com.github.tvbox.osc.ui.tv.widget.MarqueeTextView
                    android:id="@+id/tv_channel_bar_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:text="CCTV1"
                    android:textColor="@color/text_foreground"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_channel_bottom_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text_foreground"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ic_refresh"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="刷新"
                    android:padding="4dp"
                    android:src="@drawable/dkplayer_ic_action_replay"
                    app:tint="@color/text_foreground" />

                <ImageView
                    android:id="@+id/ic_cast"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="投屏"
                    android:padding="4dp"
                    android:src="@drawable/ic_cast"
                    app:tint="@color/text_foreground" />

                <ImageView
                    android:id="@+id/ic_setting"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="设置"
                    android:padding="4dp"
                    android:src="@drawable/ic_setting"
                    app:tint="@color/text_foreground" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:alpha="0.22"
            android:background="@color/text_hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/epg_program_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="2dp">

                <TextView
                    android:id="@+id/tv_epg_current"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="节目信息加载中…"
                    android:textColor="@color/text_foreground"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_epg_next"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="下一：节目名称  21:00-22:00"
                    tools:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/epg_source_controls"
                android:layout_width="106dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ic_pre_source"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="上一条线路"
                    android:padding="8dp"
                    android:rotation="-180"
                    android:src="@drawable/ic_seek_right"
                    app:tint="@color/text_foreground" />

                <TextView
                    android:id="@+id/tv_source"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="线路1"
                    android:textColor="@color/text_foreground"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/ic_next_source"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="下一条线路"
                    android:padding="8dp"
                    android:src="@drawable/ic_seek_right"
                    app:tint="@color/text_foreground" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 左侧抽屉把手。 -->
    <LinearLayout
        android:id="@+id/live_channel_drawer_toggle"
        android:layout_width="36dp"
        android:layout_height="96dp"
        android:layout_gravity="start|center_vertical"
        android:background="@drawable/bg_large_round_float"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="打开直播频道侧栏"
            android:src="@drawable/ic_live_tv_48"
            app:tint="@color/text_foreground" />
    </LinearLayout>
</FrameLayout>
